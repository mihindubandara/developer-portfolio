{
    "version": 2,
    "framework": null,
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.6.2"
        }
    },
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index.php?route=/api/$1"
        },
        {
            "src": "/(.*\\..+)",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php?route=/$1"
        }
    ]
}